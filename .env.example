# --- Supabase ---
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# IMPORTANT: service role key is secret, server-only. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Strava OAuth ---
# Create app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# --- App ---
# Public-facing URL (no trailing slash). Used for OAuth callback.
# In dev: http://localhost:3000  In prod: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin ---
# Pick a long random string. Used to gate the /admin page.
ADMIN_PASSWORD=replace-with-long-random-string

# --- Cron security ---
# Vercel auto-generates this if you don't set it; set your own for clarity.
# Used by /api/cron/sync to verify requests came from Vercel cron.
CRON_SECRET=replace-with-another-long-random-string

# --- Data encryption ---
# Used to encrypt sensitive Strava tokens/secrets before storing in Supabase.
# Must be long and random; keep consistent across deploys.
DATA_ENCRYPTION_KEY=replace-with-a-long-random-string

# --- Local UI mock mode ---
# Set to true for local UI development without Supabase.
# Dashboard API returns deterministic mock data and disables presence.
DEV_UI_MOCK=false
NEXT_PUBLIC_DEV_UI_MOCK=false
